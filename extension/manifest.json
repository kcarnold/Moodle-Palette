{
  "manifest_version": 3,
  "name": "Moodle Palette",
  "version": "0.8",
  "description": "Keyboard shortcuts and command palette for Moodle",
  "content_scripts": [
    {
      "matches": ["https://moodle.calvin.edu/*"],
      "js": ["lib/fuzzysort.js", "content/palette.js", "content/moodle-ninja.js"],
      "run_at": "document_idle",
      "world": "MAIN"
    },
    {
      "matches": ["https://moodle.calvin.edu/mod/quiz/*"],
      "js": ["content/quiz-ninja.js"],
      "run_at": "document_idle",
      "world": "MAIN"
    },
    {
      "matches": ["https://moodle.calvin.edu/*"],
      "js": ["content/ai-copilot.js"],
      "run_at": "document_idle",
      "world": "MAIN"
    },
    {
      "matches": ["https://moodle.calvin.edu/*"],
      "js": ["content/make-retrieval-quiz.js"],
      "run_at": "document_idle",
      "world": "MAIN"
    },
    {
      "matches": ["https://moodle.calvin.edu/mod/quiz/overrideedit.php*"],
      "js": ["content/quiz-override-lib.js", "content/bulk-quiz-overrides.js"],
      "run_at": "document_idle",
      "world": "MAIN"
    },
    {
      "matches": ["https://moodle.calvin.edu/grade/report/user/index.php*"],
      "js": ["content/quiz-override-lib.js", "content/user-report-overrides.js"],
      "run_at": "document_idle",
      "world": "MAIN"
    },
    {
      "matches": ["https://moodle.calvin.edu/mod/assign/view.php*"],
      "js": ["content/keyboard-rubric-grading.js"],
      "run_at": "document_idle",
      "world": "MAIN"
    },
    {
      "matches": ["https://moodle.calvin.edu/mod/forum/view.php*"],
      "js": ["content/discussion-full-credit.js"],
      "run_at": "document_idle",
      "world": "MAIN"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "ken_arnold_searchforme@calvin.edu"
    }
}
}
